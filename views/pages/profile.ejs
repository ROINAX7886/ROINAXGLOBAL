<main class="profile-page">
    <div class="container">
        <!-- Profile Banner -->
        <section class="profile-header-card">
            <div class="profile-avatar-wrap">
                <div class="profile-avatar">
                    <%= user && user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                </div>
            </div>
            <div class="profile-header-info">
                <h1>
                    <%= user ? user.name : 'Authorized User' %>
                </h1>
                <p class="profile-email"><i class="fa-regular fa-envelope"></i>
                    <%= user ? user.email : '' %>
                </p>
                <div class="profile-badges">
                    <span class="badge badge-verified"><i class="fa-solid fa-circle-check"></i> Verified
                        Enterprise</span>
                    <span class="badge badge-date">Member since <%= new Date(user ? user.createdAt :
                            Date.now()).toLocaleDateString('en-US', { month: 'short' , year: 'numeric' }) %></span>
                </div>
            </div>
            <div class="profile-header-action">
                <form action="/api/auth/logout" method="POST" style="margin: 0; display: inline;">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i> Sign Out
                    </button>
                </form>
            </div>
        </section>

        <!-- Profile Tabs Layout -->
        <div class="profile-grid">
            <!-- Sidebar Navigation -->
            <aside class="profile-sidebar">
                <nav class="profile-nav">
                    <button type="button" class="nav-item active" data-tab="account">
                        <i class="fa-regular fa-user"></i> Account Identity
                    </button>
                    <a href="/cart" class="nav-item">
                        <i class="fa-solid fa-cart-shopping"></i> Saved Cart & Packages
                    </a>
                    <button type="button" class="nav-item" data-tab="security">
                        <i class="fa-solid fa-shield-halved"></i> Credentials & Security
                    </button>
                </nav>
            </aside>

            <!-- Main Tab Views -->
            <section class="profile-content">
                <!-- Tab 1: Account Identity -->
                <div class="tab-panel active" id="tab-account">
                    <div class="panel-header">
                        <h2>Personal & Corporate Information</h2>
                        <p>Manage your account name and registered contact details.</p>
                    </div>

                    <div id="account-alert" class="auth-alert" style="display: none;"></div>

                    <form id="accountForm" class="profile-form">
                        <div class="form-group">
                            <label for="profileName">Full Name / Representative</label>
                            <input type="text" id="profileName" name="name" value="<%= user ? user.name : '' %>"
                                required autocomplete="name">
                        </div>
                        <div class="form-group">
                            <label for="profileEmail">Registered Email</label>
                            <input type="email" id="profileEmail" value="<%= user ? user.email : '' %>" disabled
                                class="input-disabled">
                            <small class="form-hint">Email address is permanently bound to this session ID.</small>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-green">Save Profile Updates</button>
                        </div>
                    </form>
                </div>

                <!-- Tab 2: Saved Cart & Packages -->
                <div class="tab-panel" id="tab-orders">
                    <div class="panel-header">
                        <h2>Active Cart & Reserved Solutions</h2>
                        <p>Review packages currently staging in your procurement session.</p>
                    </div>

                    <div id="profileCartContainer">
                        <!-- Populated by inline JavaScript -->
                    </div>
                </div>

                <!-- Tab 3: Security & Password -->
                <div class="tab-panel" id="tab-security">
                    <div class="panel-header">
                        <h2>Credential Security</h2>
                        <p>Ensure your account remains safeguarded with a secure passkey.</p>
                    </div>

                    <div id="security-alert" class="auth-alert" style="display: none;"></div>

                    <form id="securityForm" class="profile-form">
                        <div class="form-group">
                            <label for="currentPassword">Current Password</label>
                            <input type="password" id="currentPassword" name="currentPassword" required
                                autocomplete="current-password">
                        </div>
                        <div class="form-group">
                            <label for="newPassword">New Password</label>
                            <input type="password" id="newPassword" name="newPassword" minlength="6" required
                                autocomplete="new-password">
                            <small class="form-hint">Minimum 6 alphanumeric characters.</small>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-green">Update Password</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</main>