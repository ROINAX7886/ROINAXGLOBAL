<script>
    // Embedded Cart Controller
    document.addEventListener('DOMContentLoaded', () => {
        let cart = JSON.parse(localStorage.getItem('roinax_cart')) || [];

        const cartItemsList = document.getElementById('cartItemsList');
        const cartSummary = document.getElementById('cartSummary');
        const cartCountBadge = document.getElementById('cartCountBadge');
        const cartSubtotal = document.getElementById('cartSubtotal');
        const cartTax = document.getElementById('cartTax');
        const cartGrandTotal = document.getElementById('cartGrandTotal');
        const clearCartBtn = document.getElementById('clearCartBtn');
        const whatsappCheckoutBtn = document.getElementById('whatsappCheckoutBtn');
        const proceedCheckoutBtn = document.getElementById('proceedCheckoutBtn');

        function formatINR(val) {
            return '₹' + Number(val).toLocaleString('en-IN');
        }

        function saveCart() {
            localStorage.setItem('roinax_cart', JSON.stringify(cart));
            renderCart();
        }

        function renderCart() {
            const count = cart.reduce((sum, item) => sum + item.qty, 0);
            cartCountBadge.textContent = count;

            if (cart.length === 0) {
                cartItemsList.innerHTML = `
                    <div class="cart-empty-view">
                        <i class="fa-solid fa-cart-flatbed"></i>
                        <p>Your order basket is empty.<br>Select a package to start procurement.</p>
                    </div>`;
                cartSummary.style.display = 'none';
                return;
            }

            cartSummary.style.display = 'block';

            let itemsHtml = '';
            let subtotal = 0;

            cart.forEach(item => {
                const itemTotal = item.price * item.qty;
                subtotal += itemTotal;

                itemsHtml += `
                    <div class="cart-item-row" data-id="${item.id}">
                        <div class="cart-item-main">
                            <h4>${item.name}</h4>
                            <div class="cart-item-meta">
                                <span>${formatINR(item.price)} each</span>
                            </div>
                        </div>
                        <div class="cart-item-controls">
                            <div class="qty-control">
                                <button type="button" class="qty-btn dec-btn" data-id="${item.id}">-</button>
                                <span class="qty-display">${item.qty}</span>
                                <button type="button" class="qty-btn inc-btn" data-id="${item.id}">+</button>
                            </div>
                            <div class="cart-item-price">${formatINR(itemTotal)}</div>
                        </div>
                    </div>`;
            });

            cartItemsList.innerHTML = itemsHtml;

            const tax = Math.round(subtotal * 0.18);
            const grandTotal = subtotal + tax;

            cartSubtotal.textContent = formatINR(subtotal);
            cartTax.textContent = formatINR(tax);
            cartGrandTotal.textContent = formatINR(grandTotal);
        }

        // Add to Cart
        document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const card = btn.closest('.product-card');
                const id = card.dataset.id;
                const name = card.dataset.name;
                const price = Number(card.dataset.price);

                const existingIndex = cart.findIndex(i => i.id === id);
                if (existingIndex > -1) {
                    cart[existingIndex].qty += 1;
                } else {
                    cart.push({ id, name, price, qty: 1 });
                }

                saveCart();

                // Button visual feedback
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-check"></i> Added!';
                btn.classList.add('btn-added');
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.remove('btn-added');
                }, 1000);
            });
        });

        // Quantity Changes & Item Removal
        cartItemsList.addEventListener('click', (e) => {
            const decBtn = e.target.closest('.dec-btn');
            const incBtn = e.target.closest('.inc-btn');

            if (decBtn) {
                const id = decBtn.dataset.id;
                const idx = cart.findIndex(i => i.id === id);
                if (idx > -1) {
                    if (cart[idx].qty > 1) {
                        cart[idx].qty -= 1;
                    } else {
                        cart.splice(idx, 1);
                    }
                    saveCart();
                }
            } else if (incBtn) {
                const id = incBtn.dataset.id;
                const idx = cart.findIndex(i => i.id === id);
                if (idx > -1) {
                    cart[idx].qty += 1;
                    saveCart();
                }
            }
        });

        // Clear Cart
        if (clearCartBtn) {
            clearCartBtn.addEventListener('click', () => {
                if (confirm('Are you sure you want to clear your current cart?')) {
                    cart = [];
                    saveCart();
                }
            });
        }

        // WhatsApp Checkout
        if (whatsappCheckoutBtn) {
            whatsappCheckoutBtn.addEventListener('click', () => {
                if (cart.length === 0) return;

                let message = "Hello ROINAX GLOBAL, I would like to place an order for the following packages:%0A%0A";
                let subtotal = 0;

                cart.forEach((item, index) => {
                    const total = item.price * item.qty;
                    subtotal += total;
                    message += `${index + 1}. *${item.name}* (x${item.qty}) - ₹${total.toLocaleString('en-IN')}%0A`;
                });

                const tax = Math.round(subtotal * 0.18);
                const grand = subtotal + tax;

                message += `%0A*Subtotal:* ₹${subtotal.toLocaleString('en-IN')}`;
                message += `%0A*GST (18%):* ₹${tax.toLocaleString('en-IN')}`;
                message += `%0A*Estimated Total:* ₹${grand.toLocaleString('en-IN')}`;
                message += "%0A%0APlease confirm project timelines and billing requirements.";

                window.open(`https://wa.me/917318692999?text=${message}`, '_blank');
            });
        }

        // Formal Desk Redirect
        if (proceedCheckoutBtn) {
            proceedCheckoutBtn.addEventListener('click', () => {
                window.location.href = '/contact?intent=procurement';
            });
        }

        renderCart();
    });
</script>