<div class="auth-wrapper">
    <a href="/" class="back-home-link">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to Home</span>
    </a>

    <div class="auth-card">
        <div class="brand-header">
            <a href="/">
                <img src="/assets/images/logo-white.png" alt="ROINAX Global" class="auth-brand-logo"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                <div class="auth-fallback" style="display: none; font-size:1.3rem; font-weight:800; color:#fff;">
                    ROINAX<span style="color:#53a922;">.</span></div>
            </a>
            <span class="auth-tag">PORTAL</span>
        </div>

        <div class="auth-heading">
            <h2>Welcome back</h2>
            <p>Access your enterprise hardware & service panel</p>
        </div>

        <div id="errorBanner" class="error-banner" style="display: none;">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span id="errorMessage">Invalid email or password.</span>
        </div>

        <form id="loginForm" novalidate>
            <div class="form-group">
                <label for="email">Work Email</label>
                <div class="input-wrap">
                    <i class="fa-regular fa-envelope input-icon"></i>
                    <input type="email" id="email" name="email" placeholder="name@company.com" required
                        autocomplete="email">
                </div>
            </div>

            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <label for="loginPassword" style="margin-bottom: 0;">Password</label>
                    <a href="/forgot-password" class="auth-link" style="font-size: 0.78rem;">Forgot password?</a>
                </div>
                <div class="input-wrap" style="position: relative;">
                    <i class="fa-solid fa-lock input-icon"
                        style="position: absolute; left: 14px; pointer-events: none;"></i>
                    <input type="password" id="loginPassword" name="password" class="has-toggle"
                        placeholder="••••••••••••" required>
                    <button type="button" class="password-toggle-btn" data-target="loginPassword"
                        aria-label="Toggle password visibility">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-auth-submit" id="submitBtn">
                <span>Sign In</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </form>

        <div class="auth-divider"><span>OR</span></div>

        <!-- Google OAuth Redirect -->
        <a href="/api/auth/google?mode=login" class="btn-google-auth">
            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google">
            <span>Continue with Google</span>
        </a>

        <div class="auth-footer">
            Don't have an enterprise account?
            <a href="/signup">Sign up</a>
        </div>
    </div>
</div>

<!-- Forgot Password Modal Popup -->
<div id="forgotModal" class="modal-backdrop" style="display: none;">
    <div class="modal-box">
        <h3>Reset Password</h3>

        <div id="forgotStep1">
            <p style="font-size: 0.85rem; color: #a4b2a8; margin-bottom: 14px;">Enter your account email to receive a
                6-digit reset code.</p>
            <div class="input-wrap" style="margin-bottom: 14px;">
                <i class="fa-regular fa-envelope input-icon"></i>
                <input type="email" id="forgotEmail" placeholder="user@company.com">
            </div>
            <button type="button" id="btnSendForgotOtp" class="btn-auth-submit">Send Reset Code</button>
        </div>

        <div id="forgotStep2" style="display: none;">
            <p style="font-size: 0.85rem; color: #a4b2a8; margin-bottom: 14px;">Enter the code sent to your email and
                your new password.</p>
            <div class="input-wrap" style="margin-bottom: 12px;">
                <input type="text" id="resetOtp" placeholder="6-digit OTP" maxlength="6" class="otp-input">
            </div>
            <div class="input-wrap" style="margin-bottom: 14px;">
                <i class="fa-solid fa-lock input-icon"></i>
                <input type="password" id="resetNewPassword" placeholder="New Password (min 6 chars)">
            </div>
            <button type="button" id="btnConfirmReset" class="btn-auth-submit">Update Password</button>
        </div>

        <button type="button" id="btnCloseForgot" class="btn-text">Cancel</button>
    </div>
</div>

<script>
    const form = document.getElementById('loginForm');
    const submitBtn = document.getElementById('submitBtn');
    const errorBanner = document.getElementById('errorBanner');
    const errorMessage = document.getElementById('errorMessage');
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');

    togglePassword.addEventListener('click', () => {
        const isPassword = passwordInput.getAttribute('type') === 'password';
        passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
        togglePassword.innerHTML = isPassword ? '<i class="fa-regular fa-eye-slash"></i>' : '<i class="fa-regular fa-eye"></i>';
    });

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorBanner.style.display = 'none';

        const email = document.getElementById('email').value.trim();
        const password = passwordInput.value;

        if (!email || !password) {
            errorMessage.textContent = 'Please provide both email and password.';
            errorBanner.style.display = 'flex';
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Signing In...</span> <i class="fa-solid fa-spinner fa-spin"></i>';

        try {
            const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });
            const data = await res.json();

            if (res.ok && data.success) {
                const localCart = JSON.parse(localStorage.getItem('roinax_cart')) || [];
                if (localCart.length > 0) {
                    await fetch('/api/cart/sync', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ items: localCart })
                    });
                }
                window.location.href = data.redirectUrl || '/';
            } else {
                errorMessage.textContent = data.message || 'Authentication failed.';
                errorBanner.style.display = 'flex';
            }
        } catch (err) {
            errorMessage.textContent = 'Server connection error.';
            errorBanner.style.display = 'flex';
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Sign In</span> <i class="fa-solid fa-arrow-right"></i>';
        }
    });

    // Forgot Password Flow
    const forgotModal = document.getElementById('forgotModal');
    let targetResetEmail = '';

    document.getElementById('linkForgotPassword').addEventListener('click', (e) => {
        e.preventDefault();
        forgotModal.style.display = 'flex';
    });

    document.getElementById('btnCloseForgot').addEventListener('click', () => {
        forgotModal.style.display = 'none';
    });

    document.getElementById('btnSendForgotOtp').addEventListener('click', async () => {
        targetResetEmail = document.getElementById('forgotEmail').value.trim();
        if (!targetResetEmail) return alert('Please enter your email.');

        const res = await fetch('/api/auth/forgot-password-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: targetResetEmail })
        });
        const data = await res.json();
        if (res.ok && data.success) {
            document.getElementById('forgotStep1').style.display = 'none';
            document.getElementById('forgotStep2').style.display = 'block';
        } else {
            alert(data.message || 'Failed to dispatch code.');
        }
    });

    document.getElementById('btnConfirmReset').addEventListener('click', async () => {
        const otp = document.getElementById('resetOtp').value.trim();
        const newPassword = document.getElementById('resetNewPassword').value;

        if (!otp || newPassword.length < 6) {
            return alert('Enter 6-digit OTP and new password (min 6 chars).');
        }

        const res = await fetch('/api/auth/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: targetResetEmail, otp, newPassword })
        });
        const data = await res.json();
        if (res.ok && data.success) {
            alert('Password reset successful. You can now login.');
            forgotModal.style.display = 'none';
        } else {
            alert(data.message || 'Reset failed.');
        }
    });
</script>