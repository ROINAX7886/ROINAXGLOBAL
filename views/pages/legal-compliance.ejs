<main class="service-detail-page">
    <!-- Hero Banner -->
    <section class="legal-hero">
        <div class="hero-glow-orb"></div>
        <div class="container legal-hero-inner">
            <div class="eyebrow dark center">
                <span class="eyebrow-line"></span>
                <span class="eyebrow-green">Corporate Governance & Regulatory Risk</span>
                <span class="eyebrow-line"></span>
            </div>
            <h1>Commercial Contracts, Licenses & <span class="text-lime">Regulatory Compliance</span></h1>
            <p class="legal-hero-desc">
                Safeguard your enterprise with ironclad legal frameworks, business registrations, statutory compliance
                filings, and vetted commercial agreements structured for scale.
            </p>
            <div class="legal-hero-actions">
                <a href="/contact" class="btn btn-green btn-lg">
                    <span>Request Legal Consultation</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Lightweight Showcase Section -->
    <section class="legal-showcase-section">
        <div class="container">
            <div class="section-head center reveal-up">
                <div class="eyebrow center">
                    <span class="eyebrow-line"></span>
                    Documentation Pillars
                    <span class="eyebrow-line"></span>
                </div>
                <h2>Structured Corporate & Statutory Governance</h2>
            </div>

            <div class="legal-grid">
                <!-- Card 1: Business Incorporation & Licensing -->
                <article class="legal-card reveal-up" style="--delay: 0.05s">
                    <div class="legal-preview-box mesh-incorporation">
                        <div class="legal-badge"><i class="fa-solid fa-scale-balanced"></i> Entity Structuring</div>
                        <svg class="legal-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Scales of Justice Vector -->
                            <line x1="100" y1="26" x2="100" y2="94" stroke="#82d12b" stroke-width="2"
                                stroke-linecap="round" />
                            <line x1="60" y1="36" x2="140" y2="36" stroke="rgba(255,255,255,0.3)" stroke-width="2"
                                stroke-linecap="round" />
                            <circle cx="100" cy="26" r="3" fill="#82d12b" />

                            <!-- Left Pan -->
                            <line x1="60" y1="36" x2="48" y2="60" stroke="rgba(130,209,43,0.35)" stroke-width="1.2" />
                            <line x1="60" y1="36" x2="72" y2="60" stroke="rgba(130,209,43,0.35)" stroke-width="1.2" />
                            <path d="M 44 60 Q 60 70 76 60 Z" fill="rgba(83,169,34,0.18)" stroke="#82d12b"
                                stroke-width="1.5" />

                            <!-- Right Pan -->
                            <line x1="140" y1="36" x2="128" y2="60" stroke="rgba(130,209,43,0.35)" stroke-width="1.2" />
                            <line x1="140" y1="36" x2="152" y2="60" stroke="rgba(130,209,43,0.35)" stroke-width="1.2" />
                            <path d="M 124 60 Q 140 70 156 60 Z" fill="rgba(83,169,34,0.18)" stroke="#82d12b"
                                stroke-width="1.5" />

                            <!-- Base Stand -->
                            <line x1="82" y1="94" x2="118" y2="94" stroke="#82d12b" stroke-width="2.5"
                                stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="legal-card-body">
                        <h3>Business Entity Incorporation</h3>
                        <p>Complete structural setup for Private Limited, LLP, Partnership, and Sole Proprietorship
                            firms, along with MSME Udyam, GST registrations, and local trade licensing.</p>
                        <div class="tech-tags">
                            <span>Pvt Ltd & LLP</span>
                            <span>GST & MSME</span>
                            <span>Trade Licenses</span>
                        </div>
                    </div>
                </article>

                <!-- Card 2: Commercial Contracts & Agreements -->
                <article class="legal-card reveal-up" style="--delay: 0.12s">
                    <div class="legal-preview-box mesh-contracts">
                        <div class="legal-badge"><i class="fa-solid fa-file-contract"></i> Contracts & NDAs</div>
                        <svg class="legal-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Contract Document with Quill/Signature -->
                            <rect x="65" y="22" width="70" height="78" rx="4" fill="rgba(255,255,255,0.03)"
                                stroke="rgba(130,209,43,0.35)" stroke-width="1.5" />
                            <line x1="75" y1="34" x2="125" y2="34" stroke="rgba(255,255,255,0.25)" stroke-width="2" />
                            <line x1="75" y1="42" x2="115" y2="42" stroke="rgba(255,255,255,0.15)" stroke-width="2" />
                            <line x1="75" y1="50" x2="125" y2="50" stroke="rgba(255,255,255,0.15)" stroke-width="2" />
                            <line x1="75" y1="58" x2="110" y2="58" stroke="rgba(255,255,255,0.15)" stroke-width="2" />

                            <!-- Signature Path & Stamp -->
                            <path d="M 75 76 Q 85 70 95 78 T 110 74" fill="none" stroke="#82d12b" stroke-width="1.8"
                                stroke-linecap="round" />
                            <circle cx="122" cy="74" r="6" fill="rgba(83,169,34,0.2)" stroke="#53a922"
                                stroke-width="1.2" />
                        </svg>
                    </div>
                    <div class="legal-card-body">
                        <h3>Commercial Agreements & Contracts</h3>
                        <p>Drafting and vetting Non-Disclosure Agreements (NDAs), Service Level Agreements (SLAs),
                            vendor contracts, partnership deeds, and co-founder equity frameworks.</p>
                        <div class="tech-tags">
                            <span>B2B Master SLAs</span>
                            <span>Mutual NDAs</span>
                            <span>Founder Agreements</span>
                        </div>
                    </div>
                </article>

                <!-- Card 3: Regulatory Compliance & IP Filing -->
                <article class="legal-card reveal-up" style="--delay: 0.19s">
                    <div class="legal-preview-box mesh-compliance">
                        <div class="legal-badge"><i class="fa-solid fa-stamp"></i> IP & Compliance</div>
                        <svg class="legal-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Shield + Trademark/Verified Stamp -->
                            <path d="M 100 24 L 132 38 C 132 72 100 92 100 92 C 100 92 68 72 68 38 Z"
                                fill="rgba(130,209,43,0.1)" stroke="#82d12b" stroke-width="1.5" />
                            <circle cx="100" cy="56" r="16" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.2)"
                                stroke-dasharray="3,3" />
                            <text x="100" y="60" fill="#82d12b" font-size="11" font-family="Poppins, sans-serif"
                                font-weight="700" text-anchor="middle">TM</text>

                            <line x1="88" y1="80" x2="112" y2="80" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"
                                stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="legal-card-body">
                        <h3>Trademark, IP & Statutory Filings</h3>
                        <p>Trademark class search and filing, intellectual property defense, annual ROC compliance
                            filings, director KYC, and commercial data privacy policies (GDPR/DPDP).</p>
                        <div class="tech-tags">
                            <span>Trademark (TM)</span>
                            <span>ROC & KYC</span>
                            <span>Privacy & GDPR</span>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Bottom Conversion CTA -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-box reveal-up">
                <div class="cta-left">
                    <div class="cta-plane">
                        <i class="fa-solid fa-stamp"></i>
                    </div>
                    <div class="cta-text">
                        <h3>Protect Your Enterprise with Legal Clarity</h3>
                        <p>Consult with our corporate documentation specialists to review or draft your legal
                            instruments.</p>
                    </div>
                </div>
                <a href="/contact" class="btn btn-white">
                    Contact Legal Team <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
</main>