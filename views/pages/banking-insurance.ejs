<main class="service-detail-page">
    <!-- Hero Banner -->
    <section class="banking-hero">
        <div class="hero-glow-orb"></div>
        <div class="container banking-hero-inner">
            <div class="eyebrow dark center">
                <span class="eyebrow-line"></span>
                <span class="eyebrow-green">Financial Infrastructure & Enterprise Risk</span>
                <span class="eyebrow-line"></span>
            </div>
            <h1>Commercial Banking Assistance & <span class="text-lime">Business Risk Coverage</span></h1>
            <p class="banking-hero-desc">
                Accelerate capital operations with corporate current accounts, automated merchant payment gateways,
                working capital credit lines, and comprehensive liability insurance policies.
            </p>
            <div class="banking-hero-actions">
                <a href="/contact" class="btn btn-green btn-lg">
                    <span>Consult Financial Advisor</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Lightweight Showcase Section -->
    <section class="banking-showcase-section">
        <div class="container">
            <div class="section-head center reveal-up">
                <div class="eyebrow center">
                    <span class="eyebrow-line"></span>
                    Financial Pillars
                    <span class="eyebrow-line"></span>
                </div>
                <h2>Capital Operations & Enterprise Protection</h2>
            </div>

            <div class="banking-grid">
                <!-- Card 1: Corporate Banking & Current Accounts -->
                <article class="banking-card reveal-up" style="--delay: 0.05s">
                    <div class="banking-preview-box mesh-bank">
                        <div class="banking-badge"><i class="fa-solid fa-building-columns"></i> Corporate Banking</div>
                        <svg class="banking-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Bank Facade Columns -->
                            <polygon points="100,24 45,42 155,42" fill="rgba(83,169,34,0.18)" stroke="#82d12b"
                                stroke-width="1.5" />
                            <rect x="42" y="42" width="116" height="6" fill="#82d12b" />

                            <!-- Columns -->
                            <rect x="52" y="48" width="10" height="36" fill="rgba(255,255,255,0.06)"
                                stroke="rgba(130,209,43,0.3)" />
                            <rect x="80" y="48" width="10" height="36" fill="rgba(255,255,255,0.06)"
                                stroke="rgba(130,209,43,0.3)" />
                            <rect x="110" y="48" width="10" height="36" fill="rgba(255,255,255,0.06)"
                                stroke="rgba(130,209,43,0.3)" />
                            <rect x="138" y="48" width="10" height="36" fill="rgba(255,255,255,0.06)"
                                stroke="rgba(130,209,43,0.3)" />

                            <!-- Base Platform -->
                            <rect x="38" y="84" width="124" height="8" rx="2" fill="rgba(255,255,255,0.15)" />
                            <circle cx="100" cy="35" r="3.5" fill="#82d12b" />
                        </svg>
                    </div>
                    <div class="banking-card-body">
                        <h3>Corporate Banking & Current Accounts</h3>
                        <p>Streamlined corporate onboarding with Tier-1 banks, high-volume multi-currency current
                            accounts, FX trade clearance, and zero-balance operational tiers.</p>
                        <div class="tech-tags">
                            <span>Current Accounts</span>
                            <span>Multi-Currency FX</span>
                            <span>High-Limit NetBanking</span>
                        </div>
                    </div>
                </article>

                <!-- Card 2: Merchant POS & Payment Aggregation -->
                <article class="banking-card reveal-up" style="--delay: 0.12s">
                    <div class="banking-preview-box mesh-payment">
                        <div class="banking-badge"><i class="fa-solid fa-credit-card"></i> Payment Systems</div>
                        <svg class="banking-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Card Terminal & Contactless Wave -->
                            <rect x="55" y="24" width="90" height="74" rx="6" fill="rgba(255,255,255,0.03)"
                                stroke="rgba(130,209,43,0.35)" stroke-width="1.5" />
                            <rect x="65" y="32" width="70" height="24" rx="3" fill="rgba(130,209,43,0.12)"
                                stroke="rgba(130,209,43,0.25)" />
                            <text x="100" y="47" fill="#82d12b" font-size="7" font-family="Poppins, sans-serif"
                                font-weight="700" text-anchor="middle">UPI • CARDS • T+1</text>

                            <!-- Keypad Dots -->
                            <circle cx="75" cy="66" r="2.5" fill="rgba(255,255,255,0.3)" />
                            <circle cx="88" cy="66" r="2.5" fill="rgba(255,255,255,0.3)" />
                            <circle cx="100" cy="66" r="2.5" fill="rgba(255,255,255,0.3)" />
                            <circle cx="112" cy="66" r="2.5" fill="rgba(255,255,255,0.3)" />
                            <circle cx="125" cy="66" r="2.5" fill="rgba(255,255,255,0.3)" />

                            <circle cx="75" cy="78" r="2.5" fill="rgba(255,255,255,0.3)" />
                            <circle cx="88" cy="78" r="2.5" fill="rgba(255,255,255,0.3)" />
                            <circle cx="100" cy="78" r="2.5" fill="#82d12b" />
                            <circle cx="112" cy="78" r="2.5" fill="rgba(255,255,255,0.3)" />
                            <circle cx="125" cy="78" r="2.5" fill="#53a922" />
                        </svg>
                    </div>
                    <div class="banking-card-body">
                        <h3>Payment Aggregation & Merchant POS</h3>
                        <p>Enterprise payment gateway setups (Razorpay, Cashfree, Stripe), Android smart POS terminal
                            provisioning, automated UPI QR systems, and automated T+1 settlement cycles.</p>
                        <div class="tech-tags">
                            <span>Payment Gateways</span>
                            <span>Smart POS</span>
                            <span>T+1 Settlement</span>
                        </div>
                    </div>
                </article>

                <!-- Card 3: Business Insurance & Liability Protection -->
                <article class="banking-card reveal-up" style="--delay: 0.19s">
                    <div class="banking-preview-box mesh-insurance">
                        <div class="banking-badge"><i class="fa-solid fa-umbrella"></i> Risk & Insurance</div>
                        <svg class="banking-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Umbrella Shield Vector -->
                            <path d="M 60 58 Q 100 24 140 58 Z" fill="rgba(83,169,34,0.2)" stroke="#82d12b"
                                stroke-width="1.8" />
                            <line x1="100" y1="24" x2="100" y2="82" stroke="#82d12b" stroke-width="1.8"
                                stroke-linecap="round" />
                            <path d="M 100 82 C 100 89 90 89 90 82" fill="none" stroke="#82d12b" stroke-width="1.8"
                                stroke-linecap="round" />

                            <!-- Coverage Dots -->
                            <circle cx="75" cy="70" r="3" fill="rgba(255,255,255,0.2)" />
                            <circle cx="125" cy="70" r="3" fill="rgba(255,255,255,0.2)" />
                            <circle cx="100" cy="94" r="3.5" fill="#82d12b" />
                        </svg>
                    </div>
                    <div class="banking-card-body">
                        <h3>Commercial Risk & Asset Insurance</h3>
                        <p>Protect assets, operations, and leadership with Director & Officer (D&O) liability, transit
                            cargo insurance, commercial fire & burglary coverage, and group employee health policies.
                        </p>
                        <div class="tech-tags">
                            <span>D&O Liability</span>
                            <span>Cargo Transit</span>
                            <span>Fire & Asset Coverage</span>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Bottom Conversion CTA -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-box reveal-up">
                <div class="cta-left">
                    <div class="cta-plane">
                        <i class="fa-solid fa-vault"></i>
                    </div>
                    <div class="cta-text">
                        <h3>Scale and Secure Your Enterprise Capital</h3>
                        <p>Connect with our commercial finance team for corporate banking setups and customized risk
                            coverage.</p>
                    </div>
                </div>
                <a href="/contact" class="btn btn-white">
                    Contact Financial Desk <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
</main>