<main class="service-detail-page">
    <!-- Hero Banner -->
    <section class="franchise-hero">
        <div class="hero-glow-orb"></div>
        <div class="container franchise-hero-inner">
            <div class="eyebrow dark center">
                <span class="eyebrow-line"></span>
                <span class="eyebrow-green">Enterprise Scaling & Territory Expansion</span>
                <span class="eyebrow-line"></span>
            </div>
            <h1>Franchise Growth Architecture & <span class="text-lime">Market Expansion</span></h1>
            <p class="franchise-hero-desc">
                Transform proven business models into nationwide franchise networks with standardized operational
                playbooks, legal disclosure frameworks, unit economics modeling, and franchisee onboarding systems.
            </p>
            <div class="franchise-hero-actions">
                <a href="/contact" class="btn btn-green btn-lg">
                    <span>Structure Your Franchise</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

            </div>
        </div>
    </section>

    <!-- Lightweight Showcase Section -->
    <section class="franchise-showcase-section">
        <div class="container">
            <div class="section-head center reveal-up">
                <div class="eyebrow center">
                    <span class="eyebrow-line"></span>
                    Expansion Pillars
                    <span class="eyebrow-line"></span>
                </div>
                <h2>End-to-End Multi-Unit Scaling Systems</h2>
            </div>

            <div class="franchise-grid">
                <!-- Card 1: Franchise Business Modeling & Unit Economics -->
                <article class="franchise-card reveal-up" style="--delay: 0.05s">
                    <div class="franchise-preview-box mesh-model">
                        <div class="franchise-badge"><i class="fa-solid fa-chart-pie"></i> Economics & ROI</div>
                        <svg class="franchise-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Growth Chart & ROI Graph -->
                            <line x1="35" y1="95" x2="165" y2="95" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
                            <line x1="35" y1="25" x2="35" y2="95" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />

                            <!-- Trend Bars -->
                            <rect x="50" y="70" width="16" height="25" rx="2" fill="rgba(255,255,255,0.06)"
                                stroke="rgba(130,209,43,0.3)" />
                            <rect x="75" y="55" width="16" height="40" rx="2" fill="rgba(83,169,34,0.2)"
                                stroke="#53a922" />
                            <rect x="100" y="42" width="16" height="53" rx="2" fill="rgba(130,209,43,0.25)"
                                stroke="#82d12b" />
                            <rect x="125" y="30" width="16" height="65" rx="2" fill="#82d12b" />

                            <!-- Trend Line with Dots -->
                            <path d="M 58 66 L 83 50 L 108 38 L 133 24" fill="none" stroke="#ffffff"
                                stroke-width="1.8" />
                            <circle cx="133" cy="24" r="3.5" fill="#82d12b" stroke="#ffffff" stroke-width="1.2" />
                        </svg>
                    </div>
                    <div class="franchise-card-body">
                        <h3>Unit Economics & Royalty Modeling</h3>
                        <p>Calculate sustainable franchisee ROI, capital expenditure (CAPEX), recurring royalty fees,
                            marketing fund splits, and payback benchmarks across retail territories.</p>
                        <div class="tech-tags">
                            <span>FOFO & FOCO Models</span>
                            <span>CAPEX & OPEX</span>
                            <span>Royalty Structuring</span>
                        </div>
                    </div>
                </article>

                <!-- Card 2: Operations Manuals & Standard SOPs -->
                <article class="franchise-card reveal-up" style="--delay: 0.12s">
                    <div class="franchise-preview-box mesh-sop">
                        <div class="franchise-badge"><i class="fa-solid fa-book-open-reader"></i> SOPs & Governance
                        </div>
                        <svg class="franchise-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Operations Manual Blueprint -->
                            <rect x="60" y="24" width="80" height="72" rx="4" fill="rgba(255,255,255,0.03)"
                                stroke="rgba(130,209,43,0.35)" stroke-width="1.5" />
                            <line x1="72" y1="36" x2="128" y2="36" stroke="#82d12b" stroke-width="2"
                                stroke-linecap="round" />

                            <line x1="72" y1="46" x2="120" y2="46" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
                            <line x1="72" y1="54" x2="128" y2="54" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
                            <line x1="72" y1="62" x2="114" y2="62" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />

                            <!-- Verified Compliance Checkmark -->
                            <circle cx="100" cy="78" r="10" fill="rgba(83,169,34,0.2)" stroke="#53a922"
                                stroke-width="1.5" />
                            <path d="M 96 78 L 99 81 L 105 75" fill="none" stroke="#82d12b" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div class="franchise-card-body">
                        <h3>Standard Operating Procedures (SOPs)</h3>
                        <p>Complete operational handbooks covering staff training, supply chain replenishment, service
                            quality control, brand compliance, and site selection guidelines.</p>
                        <div class="tech-tags">
                            <span>Operations Manual</span>
                            <span>Supply Auditing</span>
                            <span>Staff Training Kits</span>
                        </div>
                    </div>
                </article>

                <!-- Card 3: Network Topologies & Territory Expansion -->
                <article class="franchise-card reveal-up" style="--delay: 0.19s">
                    <div class="franchise-preview-box mesh-network">
                        <div class="franchise-badge"><i class="fa-solid fa-network-wired"></i> Territory Nodes</div>
                        <svg class="franchise-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Multi-Unit Franchise Node Topology -->
                            <!-- Central Flagship HQ Node -->
                            <circle cx="100" cy="40" r="12" fill="rgba(83,169,34,0.3)" stroke="#82d12b"
                                stroke-width="2" />
                            <circle cx="100" cy="40" r="4" fill="#ffffff" />

                            <!-- Radiating Network Nodes -->
                            <line x1="100" y1="52" x2="55" y2="85" stroke="rgba(130,209,43,0.35)" stroke-width="1.5"
                                stroke-dasharray="3,3" />
                            <line x1="100" y1="52" x2="100" y2="85" stroke="rgba(130,209,43,0.35)" stroke-width="1.5"
                                stroke-dasharray="3,3" />
                            <line x1="100" y1="52" x2="145" y2="85" stroke="rgba(130,209,43,0.35)" stroke-width="1.5"
                                stroke-dasharray="3,3" />

                            <circle cx="55" cy="85" r="8" fill="rgba(255,255,255,0.06)" stroke="rgba(130,209,43,0.4)"
                                stroke-width="1.5" />
                            <circle cx="100" cy="85" r="8" fill="rgba(255,255,255,0.06)" stroke="rgba(130,209,43,0.4)"
                                stroke-width="1.5" />
                            <circle cx="145" cy="85" r="8" fill="rgba(255,255,255,0.06)" stroke="rgba(130,209,43,0.4)"
                                stroke-width="1.5" />

                            <text x="100" y="106" fill="#82d12b" font-size="7" font-family="Poppins, sans-serif"
                                font-weight="700" text-anchor="middle">REGIONAL NETWORK HUBS</text>
                        </svg>
                    </div>
                    <div class="franchise-card-body">
                        <h3>Territory Mapping & Partner Recruitment</h3>
                        <p>Multi-city expansion roadmaps, exclusive territory demarcation, master franchisee vetting
                            frameworks, and digital investor pitch decks to sign franchise partners.</p>
                        <div class="tech-tags">
                            <span>Territory Demarcation</span>
                            <span>Master Franchise</span>
                            <span>Investor Pitch Decks</span>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Bottom Conversion CTA -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-box reveal-up">
                <div class="cta-left">
                    <div class="cta-plane">
                        <i class="fa-solid fa-sitemap"></i>
                    </div>
                    <div class="cta-text">
                        <h3>Ready to Multiply Your Business Footprint?</h3>
                        <p>Speak with our franchise advisory consultants to design your rollout strategy.</p>
                    </div>
                </div>
                <a href="/contact" class="btn btn-white">
                    Book Expansion Strategy <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
</main>