<main class="service-detail-page">
    <!-- Hero Banner -->
    <section class="hosting-hero">
        <div class="hero-glow-orb"></div>
        <div class="container hosting-hero-inner">
            <div class="eyebrow dark center">
                <span class="eyebrow-line"></span>
                <span class="eyebrow-green">Infrastructure & Cloud Services</span>
                <span class="eyebrow-line"></span>
            </div>
            <h1>Secure Domain Management & <span class="text-lime">High-Speed Cloud Hosting</span></h1>
            <p class="hosting-hero-desc">
                Protect your brand identity with enterprise-grade domain provisioning, zero-downtime cloud
                infrastructure, automated SSL encryption, and dedicated corporate email environments.
            </p>
            <div class="hosting-hero-actions">
                <a href="/contact" class="btn btn-green btn-lg">
                    <span>Provision Your Infrastructure</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Lightweight Showcase Section -->
    <section class="hosting-showcase-section">
        <div class="container">
            <div class="section-head center reveal-up">
                <div class="eyebrow center">
                    <span class="eyebrow-line"></span>
                    Infrastructure Pillars
                    <span class="eyebrow-line"></span>
                </div>
                <h2>Reliable, Fast & Certified Hosting</h2>
            </div>

            <div class="hosting-grid">
                <!-- Card 1: Domain Portfolio & DNS Management -->
                <article class="hosting-card reveal-up" style="--delay: 0.05s">
                    <div class="hosting-preview-box mesh-dns">
                        <div class="hosting-badge"><i class="fa-solid fa-globe"></i> Domain & DNS</div>
                        <svg class="hosting-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Globe & DNS Records Visual -->
                            <circle cx="60" cy="60" r="32" fill="none" stroke="rgba(130,209,43,0.3)"
                                stroke-width="1.5" />
                            <ellipse cx="60" cy="60" rx="32" ry="12" fill="none" stroke="rgba(130,209,43,0.2)"
                                stroke-dasharray="3,3" />
                            <ellipse cx="60" cy="60" rx="14" ry="32" fill="none" stroke="rgba(130,209,43,0.2)"
                                stroke-dasharray="3,3" />
                            <line x1="60" y1="28" x2="60" y2="92" stroke="rgba(255,255,255,0.15)" />

                            <!-- DNS Record Blocks -->
                            <rect x="115" y="32" width="60" height="14" rx="3" fill="rgba(255,255,255,0.04)"
                                stroke="rgba(130,209,43,0.3)" />
                            <text x="120" y="42" fill="#82d12b" font-size="7" font-family="Poppins, sans-serif"
                                font-weight="700">A RECORD</text>
                            <rect x="115" y="52" width="60" height="14" rx="3" fill="rgba(255,255,255,0.04)"
                                stroke="rgba(255,255,255,0.15)" />
                            <text x="120" y="62" fill="#ffffff" font-size="7" font-family="Poppins, sans-serif"
                                font-weight="600">CNAME</text>
                            <rect x="115" y="72" width="60" height="14" rx="3" fill="rgba(255,255,255,0.04)"
                                stroke="rgba(130,209,43,0.3)" />
                            <text x="120" y="82" fill="#82d12b" font-size="7" font-family="Poppins, sans-serif"
                                font-weight="700">MX RECORD</text>

                            <!-- Connecting Line -->
                            <path d="M 92 60 L 115 60" stroke="rgba(130,209,43,0.4)" stroke-width="1.5"
                                stroke-dasharray="2,2" />
                        </svg>
                    </div>
                    <div class="hosting-card-body">
                        <h3>Domain Registration & Anycast DNS</h3>
                        <p>Global TLD acquisition (.com, .in, .org, .co, .io), WHOIS privacy protection, DNSSEC security
                            hardening, and ultra-low latency Cloudflare Anycast routing.</p>
                        <div class="tech-tags">
                            <span>TLD Provisioning</span>
                            <span>WHOIS Privacy</span>
                            <span>Anycast DNS</span>
                        </div>
                    </div>
                </article>

                <!-- Card 2: High-Performance Cloud & NVMe Hosting -->
                <article class="hosting-card reveal-up" style="--delay: 0.12s">
                    <div class="hosting-preview-box mesh-server">
                        <div class="hosting-badge"><i class="fa-solid fa-server"></i> Cloud VPS & NVMe</div>
                        <svg class="hosting-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Server Rack Tower -->
                            <rect x="50" y="24" width="100" height="20" rx="3" fill="rgba(255,255,255,0.03)"
                                stroke="rgba(130,209,43,0.35)" stroke-width="1.5" />
                            <circle cx="62" cy="34" r="3" fill="#82d12b" />
                            <line x1="74" y1="34" x2="135" y2="34" stroke="rgba(255,255,255,0.2)" stroke-width="2"
                                stroke-linecap="round" />

                            <rect x="50" y="50" width="100" height="20" rx="3" fill="rgba(255,255,255,0.03)"
                                stroke="rgba(130,209,43,0.35)" stroke-width="1.5" />
                            <circle cx="62" cy="60" r="3" fill="#82d12b" />
                            <line x1="74" y1="60" x2="135" y2="60" stroke="rgba(255,255,255,0.2)" stroke-width="2"
                                stroke-linecap="round" />

                            <rect x="50" y="76" width="100" height="20" rx="3" fill="rgba(255,255,255,0.03)"
                                stroke="rgba(130,209,43,0.35)" stroke-width="1.5" />
                            <circle cx="62" cy="86" r="3" fill="#53a922" />
                            <line x1="74" y1="86" x2="135" y2="86" stroke="rgba(255,255,255,0.2)" stroke-width="2"
                                stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="hosting-card-body">
                        <h3>NVMe Cloud Web Hosting</h3>
                        <p>High-speed SSD/NVMe server clusters equipped with multi-tier caching, automated daily
                            backups, 99.9% uptime SLAs, and seamless resource autoscaling.</p>
                        <div class="tech-tags">
                            <span>NVMe Storage</span>
                            <span>99.9% Uptime SLA</span>
                            <span>Auto Backups</span>
                        </div>
                    </div>
                </article>

                <!-- Card 3: SSL Certificates & Corporate Email -->
                <article class="hosting-card reveal-up" style="--delay: 0.19s">
                    <div class="hosting-preview-box mesh-security">
                        <div class="hosting-badge"><i class="fa-solid fa-shield-halved"></i> Security & Email</div>
                        <svg class="hosting-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Shield + Padlock Graphic -->
                            <path d="M 100 24 L 132 38 C 132 72 100 92 100 92 C 100 92 68 72 68 38 Z"
                                fill="rgba(130,209,43,0.1)" stroke="#82d12b" stroke-width="1.5" />
                            <!-- Padlock Icon -->
                            <rect x="91" y="54" width="18" height="14" rx="2" fill="#53a922" />
                            <path d="M 94 54 L 94 48 C 94 44.5 106 44.5 106 48 L 106 54" fill="none" stroke="#ffffff"
                                stroke-width="1.5" />
                            <circle cx="100" cy="60" r="1.5" fill="#ffffff" />
                        </svg>
                    </div>
                    <div class="hosting-card-body">
                        <h3>SSL Certificates & Business Email</h3>
                        <p>End-to-end TLS/SSL encryption certificates, custom-branded business mailboxes
                            (`name@company.com`), DKIM/SPF/DMARC anti-spam protocols, and 24/7 server monitoring.</p>
                        <div class="tech-tags">
                            <span>Free SSL / TLS</span>
                            <span>Branded Webmail</span>
                            <span>DKIM & DMARC</span>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Bottom Conversion CTA -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-box reveal-up">
                <div class="cta-left">
                    <div class="cta-plane">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                    </div>
                    <div class="cta-text">
                        <h3>Ready to Launch Your Digital Infrastructure?</h3>
                        <p>Get in touch for custom server architectures, domain transfers, or cloud configurations.</p>
                    </div>
                </div>
                <a href="/contact" class="btn btn-white">
                    Contact Us Today <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
</main>