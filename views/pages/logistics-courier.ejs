<main class="service-detail-page">
    <!-- Hero Banner -->
    <section class="logistics-hero">
        <div class="hero-glow-orb"></div>
        <div class="container logistics-hero-inner">
            <div class="eyebrow dark center">
                <span class="eyebrow-line"></span>
                <span class="eyebrow-green">Cross-Border Freight & Supply Chain</span>
                <span class="eyebrow-line"></span>
            </div>
            <h1>Worldwide Express Courier & <span class="text-lime">End-to-End Freight Logistics</span></h1>
            <p class="logistics-hero-desc">
                Streamline commercial trade, e-commerce exports, and priority parcel shipping with rapid customs
                clearance, multi-modal transport networks, and transparent end-to-end tracking.
            </p>
            <div class="logistics-hero-actions">
                <a href="/contact" class="btn btn-green btn-lg">
                    <span>Request Logistics Quote</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Lightweight Showcase Section -->
    <section class="logistics-showcase-section">
        <div class="container">
            <div class="section-head center reveal-up">
                <div class="eyebrow center">
                    <span class="eyebrow-line"></span>
                    Logistics Capabilities
                    <span class="eyebrow-line"></span>
                </div>
                <h2>Seamless International Trade & Transit</h2>
            </div>

            <div class="logistics-grid">
                <!-- Card 1: International Express Courier -->
                <article class="logistics-card reveal-up" style="--delay: 0.05s">
                    <div class="logistics-preview-box mesh-air">
                        <div class="logistics-badge"><i class="fa-solid fa-plane-departure"></i> Express Air</div>
                        <svg class="logistics-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Flight Path Arc & Air Cargo Plane -->
                            <path d="M 28 88 Q 90 25 170 45" fill="none" stroke="rgba(130,209,43,0.35)"
                                stroke-width="1.8" stroke-dasharray="4,4" />
                            <circle cx="28" cy="88" r="4" fill="#53a922" />
                            <circle cx="170" cy="45" r="4" fill="#82d12b" />

                            <!-- Cargo Plane Silhouette -->
                            <g transform="translate(98, 40) rotate(-15)">
                                <path d="M -12 0 L 12 0 L 16 3 L -8 3 Z" fill="#82d12b" />
                                <path d="M 0 0 L -4 -12 L 2 -12 L 4 0 Z" fill="#ffffff" />
                                <path d="M -8 3 L -10 9 L -6 9 L -4 3 Z" fill="#82d12b" />
                            </g>

                            <!-- Transit Metric Label -->
                            <rect x="75" y="80" width="50" height="14" rx="3" fill="rgba(255,255,255,0.04)"
                                stroke="rgba(130,209,43,0.3)" />
                            <text x="100" y="90" fill="#82d12b" font-size="6.5" font-family="Poppins, sans-serif"
                                font-weight="700" text-anchor="middle">PRIORITY AIR</text>
                        </svg>
                    </div>
                    <div class="logistics-card-body">
                        <h3>International Express Courier</h3>
                        <p>Door-to-door express deliveries, fast sample transfers, and documents shipping with
                            guaranteed transit times across major global commercial hubs and retail networks.</p>
                        <div class="tech-tags">
                            <span>Air Express</span>
                            <span>Door-to-Door</span>
                            <span>Time-Definite</span>
                        </div>
                    </div>
                </article>

                <!-- Card 2: Commercial Freight & Multi-Modal Shipping -->
                <article class="logistics-card reveal-up" style="--delay: 0.12s">
                    <div class="logistics-preview-box mesh-freight">
                        <div class="logistics-badge"><i class="fa-solid fa-ship"></i> Cargo & Ocean</div>
                        <svg class="logistics-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Shipping Container Block -->
                            <rect x="55" y="35" width="90" height="42" rx="3" fill="rgba(255,255,255,0.03)"
                                stroke="rgba(130,209,43,0.35)" stroke-width="1.5" />
                            <!-- Container Ribs -->
                            <line x1="70" y1="35" x2="70" y2="77" stroke="rgba(130,209,43,0.25)" stroke-width="1.5" />
                            <line x1="85" y1="35" x2="85" y2="77" stroke="rgba(130,209,43,0.25)" stroke-width="1.5" />
                            <line x1="100" y1="35" x2="100" y2="77" stroke="rgba(130,209,43,0.25)" stroke-width="1.5" />
                            <line x1="115" y1="35" x2="115" y2="77" stroke="rgba(130,209,43,0.25)" stroke-width="1.5" />
                            <line x1="130" y1="35" x2="130" y2="77" stroke="rgba(130,209,43,0.25)" stroke-width="1.5" />

                            <!-- Cargo Specs -->
                            <text x="100" y="93" fill="#ffffff" font-size="7" font-family="Poppins, sans-serif"
                                font-weight="600" text-anchor="middle">FCL / LCL CARGO TRANSIT</text>
                        </svg>
                    </div>
                    <div class="logistics-card-body">
                        <h3>Commercial Freight & Bulk Cargo</h3>
                        <p>Flexible Full Container Load (FCL) and Less than Container Load (LCL) freight operations
                            across sea and air routes designed for bulk shipments and wholesale distributions.</p>
                        <div class="tech-tags">
                            <span>FCL & LCL</span>
                            <span>Ocean Freight</span>
                            <span>Multi-Modal</span>
                        </div>
                    </div>
                </article>

                <!-- Card 3: Customs Brokerage & Warehousing -->
                <article class="logistics-card reveal-up" style="--delay: 0.19s">
                    <div class="logistics-preview-box mesh-customs">
                        <div class="logistics-badge"><i class="fa-solid fa-file-shield"></i> Customs & Compliance</div>
                        <svg class="logistics-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Certified Document & Stamp Graphic -->
                            <rect x="68" y="24" width="64" height="72" rx="4" fill="rgba(255,255,255,0.03)"
                                stroke="rgba(255,255,255,0.2)" stroke-width="1.2" />
                            <line x1="78" y1="36" x2="122" y2="36" stroke="rgba(255,255,255,0.2)" stroke-width="2" />
                            <line x1="78" y1="44" x2="114" y2="44" stroke="rgba(255,255,255,0.15)" stroke-width="2" />
                            <line x1="78" y1="52" x2="122" y2="52" stroke="rgba(255,255,255,0.15)" stroke-width="2" />

                            <!-- Approved Stamp -->
                            <circle cx="106" cy="72" r="14" fill="rgba(83,169,34,0.15)" stroke="#82d12b"
                                stroke-width="1.5" />
                            <path d="M 100 72 L 104 76 L 112 68" fill="none" stroke="#82d12b" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div class="logistics-card-body">
                        <h3>Customs Clearance & Documentation</h3>
                        <p>Seamless regulatory clearing, import/export duty assessment, HS code classification, and
                            secure bonded warehousing to eliminate port bottlenecks and border delays.</p>
                        <div class="tech-tags">
                            <span>HS Code Mapping</span>
                            <span>Customs Clearance</span>
                            <span>Bonded Storage</span>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Bottom Conversion CTA -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-box reveal-up">
                <div class="cta-left">
                    <div class="cta-plane">
                        <i class="fa-solid fa-earth-americas"></i>
                    </div>
                    <div class="cta-text">
                        <h3>Ready to Dispatch Cargo Globally?</h3>
                        <p>Provide your cargo dimensions, pickup location, and destination for a competitive transit
                            quote.</p>
                    </div>
                </div>
                <a href="/contact" class="btn btn-white">
                    Get Freight Quote <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
</main>