            <div class="section-head center reveal-up">
                <div class="eyebrow center">
                    <span class="eyebrow-line"></span>
                    Solutions
                    <span class="eyebrow-line"></span>
                </div>
                <h2>Built for Scale, Speed & Revenue</h2>
            </div>

            <div class="web-grid">
                <!-- Card 1: Corporate & Custom Web Portals -->
                <article class="web-card reveal-up" style="--delay: 0.05s">
                    <div class="web-preview-box mesh-portal">
                        <div class="web-badge"><i class="fa-solid fa-laptop-code"></i> Corporate Web</div>
                        <svg class="web-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Browser Frame Mockup -->
                            <rect x="25" y="20" width="150" height="85" rx="5" fill="rgba(255,255,255,0.03)"
                                stroke="rgba(130,209,43,0.3)" stroke-width="1.5" />
                            <circle cx="35" cy="28" r="2.5" fill="rgba(255,255,255,0.2)" />
                            <circle cx="43" cy="28" r="2.5" fill="rgba(255,255,255,0.2)" />
                            <circle cx="51" cy="28" r="2.5" fill="rgba(255,255,255,0.2)" />
                            <line x1="25" y1="36" x2="175" y2="36" stroke="rgba(255,255,255,0.1)" />
                            <!-- Layout Grid -->
                            <rect x="35" y="44" width="60" height="6" rx="2" fill="#82d12b" />
                            <rect x="35" y="55" width="85" height="3" rx="1.5" fill="rgba(255,255,255,0.2)" />
                            <rect x="35" y="62" width="70" height="3" rx="1.5" fill="rgba(255,255,255,0.2)" />
                            <rect x="35" y="74" width="30" height="10" rx="3" fill="#53a922" />
                            <!-- Right Column Feature Card -->
                            <rect x="130" y="44" width="35" height="40" rx="3" fill="rgba(130,209,43,0.1)"
                                stroke="rgba(130,209,43,0.3)" />
                        </svg>
                    </div>
                    <div class="web-card-body">
                        <h3>Corporate & Enterprise Portals</h3>
                        <p>High-converting business websites built on clean server layouts, SEO-optimized markup, fast
                            loading assets, and intuitive responsive navigation across all mobile devices.</p>
                        <div class="tech-tags">
                            <span>Node.js / Express</span>
                            <span>EJS & SSR</span>
                            <span>Core Web Vitals</span>
                        </div>
                    </div>
                </article>

                <!-- Card 2: E-Commerce Storefronts -->
                <article class="web-card reveal-up" style="--delay: 0.12s">
                    <div class="web-preview-box mesh-shop">
                        <div class="web-badge"><i class="fa-solid fa-cart-shopping"></i> E-Commerce</div>
                        <svg class="web-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- Storefront Product Cards & Cart Mockup -->
                            <rect x="25" y="20" width="150" height="85" rx="5" fill="rgba(255,255,255,0.03)"
                                stroke="rgba(130,209,43,0.3)" stroke-width="1.5" />
                            <line x1="25" y1="36" x2="175" y2="36" stroke="rgba(255,255,255,0.1)" />
                            <rect x="150" y="25" width="16" height="6" rx="3" fill="rgba(130,209,43,0.4)" />
                            <!-- Product Grid -->
                            <rect x="35" y="44" width="40" height="42" rx="3" fill="rgba(255,255,255,0.04)"
                                stroke="rgba(255,255,255,0.1)" />
                            <circle cx="55" cy="58" r="8" fill="rgba(130,209,43,0.2)" />
                            <rect x="40" y="72" width="30" height="3" rx="1.5" fill="#82d12b" />
                            <rect x="40" y="78" width="18" height="3" rx="1.5" fill="rgba(255,255,255,0.3)" />

                            <rect x="85" y="44" width="40" height="42" rx="3" fill="rgba(255,255,255,0.04)"
                                stroke="rgba(255,255,255,0.1)" />
                            <circle cx="105" cy="58" r="8" fill="rgba(130,209,43,0.2)" />
                            <rect x="90" y="72" width="30" height="3" rx="1.5" fill="#82d12b" />
                            <rect x="90" y="78" width="18" height="3" rx="1.5" fill="rgba(255,255,255,0.3)" />

                            <rect x="135" y="44" width="30" height="42" rx="3" fill="rgba(130,209,43,0.06)"
                                stroke="rgba(130,209,43,0.2)" />
                        </svg>
                    </div>
                    <div class="web-card-body">
                        <h3>Custom E-Commerce Stores</h3>
                        <p>End-to-end shopping carts, dynamic product listings, inventory filtering, automated
                            transaction emails, and secure payment gateway integrations (UPI, Cards, NetBanking).</p>
                        <div class="tech-tags">
                            <span>Payment Gateways</span>
                            <span>Order Management</span>
                            <span>PostgreSQL / DB</span>
                        </div>
                    </div>
                </article>

                <!-- Card 3: Custom Web Apps & API Integrations -->
                <article class="web-card reveal-up" style="--delay: 0.19s">
                    <div class="web-preview-box mesh-apps">
                        <div class="web-badge"><i class="fa-solid fa-server"></i> Web Applications</div>
                        <svg class="web-blueprint-svg" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                            <!-- API & Database Logic Nodes -->
                            <circle cx="60" cy="60" r="18" fill="rgba(83,169,34,0.15)" stroke="#53a922"
                                stroke-width="1.5" />
                            <circle cx="140" cy="60" r="18" fill="rgba(130,209,43,0.15)" stroke="#82d12b"
                                stroke-width="1.5" />
                            <path d="M 78 60 L 122 60" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"
                                stroke-dasharray="3,3" />
                            <polygon points="122,57 127,60 122,63" fill="#82d12b" />
                            <!-- App Labels -->
                            <text x="60" y="63" fill="#ffffff" font-size="7" font-family="Poppins, sans-serif"
                                font-weight="600" text-anchor="middle">API</text>
                            <text x="140" y="63" fill="#ffffff" font-size="7" font-family="Poppins, sans-serif"
                                font-weight="600" text-anchor="middle">DATABASE</text>
                            <circle cx="100" cy="35" r="4" fill="#82d12b" />
                            <circle cx="100" cy="85" r="4" fill="#53a922" />
                        </svg>
                    </div>
                    <div class="web-card-body">
                        <h3>Custom Web Apps & Automation</h3>
                        <p>Customer dashboards, role-based administration panels, automated lead capture workflows, and
                            bespoke REST API services tailored directly to your business model.</p>
                        <div class="tech-tags">
                            <span>REST APIs</span>
                            <span>Role-Based Auth</span>
                            <span>Automation Hooks</span>
                        </div>
                    </div>
                </article>
            </div>
