<main class="service-detail-page">
    <!-- Hero Banner -->
    <section class="web-hero">
        <div class="hero-glow-orb"></div>
        <div class="container web-hero-inner">
            <div class="eyebrow dark center">
                <span class="eyebrow-line"></span>
                <span class="eyebrow-green">Engineering & Digital Commerce</span>
                <span class="eyebrow-line"></span>
            </div>
            <h1>High-Performance Websites & <span class="text-lime">E-Commerce Platforms</span></h1>
            <p class="web-hero-desc">
                From headless online storefronts to responsive corporate portals, we build lightning-fast web systems
                engineered for high conversion, search visibility, and seamless checkout operations.
            </p>
            <div class="web-hero-actions">
                <a href="/contact" class="btn btn-green btn-lg">
                    <span>Discuss Your Web Project</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Lightweight Showcase Section -->
    <section class="web-showcase-section">
