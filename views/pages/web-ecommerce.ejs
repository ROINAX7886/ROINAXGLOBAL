    <!-- Bottom Action CTA -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-box reveal-up">
                <div class="cta-left">
                    <div class="cta-plane">
                        <i class="fa-solid fa-code"></i>
                    </div>
                    <div class="cta-text">
                        <h3>Need a Custom Web or E-Commerce Solution?</h3>
                        <p>Share your technical requirements and our team will prepare a structured proposal.</p>
                    </div>
                </div>
                <a href="/contact" class="btn btn-white">
                    Contact Our Team <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
</main>