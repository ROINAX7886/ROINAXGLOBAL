<section class="auth-section">
    <div class="auth-card">
        <h2 class="auth-title">Create ROINAX Account</h2>
        <p class="auth-subtitle">Procure hardware & enterprise banking solutions</p>

        <!-- STEP 1: Enter Registration Details -->
        <form id="signupDetailsForm" class="auth-form">
            <div class="form-group">
                <label for="fullName">Full Name</label>
                <input type="text" id="fullName" name="fullName" required placeholder="John Doe">
            </div>
            <div class="form-group">
                <label for="email">Work / Personal Email</label>
                <input type="email" id="email" name="email" required placeholder="name@domain.com">
            </div>
            <div class="form-group">
                <label for="password">Password (min 6 characters)</label>
                <input type="password" id="password" name="password" minlength="6" required placeholder="••••••••">
            </div>

            <!-- Terms & Privacy Legal Statement -->
            <p class="terms-notice">
                By clicking "Send Verification OTP", you agree to our
                <a href="/terms" target="_blank">Terms of Service</a> and
                <a href="/privacy" target="_blank">Privacy Policy</a>.
            </p>

            <button type="submit" id="btnSendOtp" class="btn-primary-auth">Send Verification OTP</button>
        </form>

        <!-- STEP 2: Verify OTP (Hidden Initially) -->
        <form id="signupOtpForm" class="auth-form" style="display: none; margin-top: 1rem;">
            <div class="alert-info">
                OTP sent to <strong id="displayTargetEmail"></strong>
            </div>
            <div class="form-group">
                <label for="otpCode">6-Digit Email Verification Code</label>
                <input type="text" id="otpCode" name="otp" maxlength="6" required placeholder="123456"
                    class="otp-input">
            </div>

            <button type="submit" id="btnVerifySignup" class="btn-primary-auth">Verify & Complete Signup</button>
            <button type="button" id="btnBackToDetails" class="btn-text">Edit Details</button>
        </form>

        <div class="auth-divider"><span>OR</span></div>

        <!-- Google OAuth Button -->
        <a href="/api/auth/google" class="btn-google-auth">
            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google">
            <span>Continue with Google</span>
        </a>

        <!-- Secondary consent notice for third-party auth -->
        <p class="terms-notice" style="margin-top: 10px;">
            By signing in with Google, you accept our <a href="/terms" target="_blank">Terms</a> and <a href="/privacy"
                target="_blank">Privacy Policy</a>.
        </p>

        <p class="auth-footer">Already have an account? <a href="/login">Sign In</a></p>
    </div>
</section>

<script>
    const detailsForm = document.getElementById('signupDetailsForm');
    const otpForm = document.getElementById('signupOtpForm');
    const btnSendOtp = document.getElementById('btnSendOtp');
    const btnVerify = document.getElementById('btnVerifySignup');

    let signupData = {};

    detailsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        btnSendOtp.disabled = true;
        btnSendOtp.innerText = 'Sending OTP...';

        signupData = {
            name: document.getElementById('fullName').value.trim(),
            email: document.getElementById('email').value.trim(),
            password: document.getElementById('password').value
        };

        try {
            const res = await fetch('/api/auth/send-signup-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: signupData.email })
            });
            const data = await res.json();

            if (res.ok && data.success) {
                document.getElementById('displayTargetEmail').textContent = signupData.email;
                detailsForm.style.display = 'none';
                otpForm.style.display = 'block';
            } else {
                alert(data.message || 'Failed to send OTP.');
            }
        } catch (err) {
            alert('Network error while requesting verification code.');
        } finally {
            btnSendOtp.disabled = false;
            btnSendOtp.innerText = 'Send Verification OTP';
        }
    });

    otpForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        btnVerify.disabled = true;
        btnVerify.innerText = 'Verifying...';

        const otp = document.getElementById('otpCode').value.trim();

        try {
            const res = await fetch('/api/auth/verify-signup-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ...signupData, otp })
            });
            const data = await res.json();

            if (res.ok && data.success) {
                const localCart = JSON.parse(localStorage.getItem('roinax_cart')) || [];
                if (localCart.length > 0) {
                    await fetch('/api/cart/sync', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ items: localCart })
                    });
                }
                window.location.href = data.redirectUrl || '/';
            } else {
                alert(data.message || 'Invalid verification code.');
            }
        } catch (err) {
            alert('Server error verifying signup OTP.');
        } finally {
            btnVerify.disabled = false;
            btnVerify.innerText = 'Verify & Complete Signup';
        }
    });

    document.getElementById('btnBackToDetails').addEventListener('click', () => {
        otpForm.style.display = 'none';
        detailsForm.style.display = 'block';
    });
</script>