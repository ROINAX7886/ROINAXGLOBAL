<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'ROINAX Global | End-to-End Business Solutions' %>
    </title>
    <link rel="icon" type="image/png" href="/assets/images/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Base Global Stylesheet -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Optional Page-Specific Stylesheet -->
    <% if (typeof extraCss !=='undefined' ) { %>
        <link rel="stylesheet" href="<%= extraCss %>">
        <% } %>
</head>

<body>
    <div class="preloader" id="preloader">
        <div class="loader-inner">
            <div class="loader-ring"></div>
            <div class="loader-brand">
                <span class="loader-title">ROINAX</span>
                <span class="loader-sub">GLOBAL</span>
            </div>
            <div class="loader-bar">
                <div class="loader-progress"></div>
            </div>
        </div>
    </div>

    <div class="scroll-progress" id="scrollProgress"></div>

    <%- include('../partials/header') %>

        <%- body %>

            <%- include('../partials/footer') %>

                <script src="/js/main.js"></script>
</body>

</html>